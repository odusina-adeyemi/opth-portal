{
  "name": "ophthalm-comanagement",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run format && npm run lint && next build",
    "start": "next start",
    "lint": "eslint . --fix",
    "pre-commit": "eslint . && tsc --noEmit && sh ../.git/hooks/pre-commit",
    "vercel-build": "npx prisma generate && npx prisma migrate deploy && next build",
    "postbuild": "ts-node ./src/scripts/add-urls-to-kinde.ts",
    "format": "prettier --write .",
    "prisma": "npx prisma"
  },
  "dependencies": {
    "@apollo/client": "^3.11.10",
    "@apollo/experimental-nextjs-app-support": "^0.11.6",
    "@apollo/server": "^4.11.0",
    "@as-integrations/next": "^3.0.0",
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@google-cloud/logging": "^11.2.0",
    "@google-cloud/storage": "^7.13.0",
    "@graphql-tools/schema": "^10.0.6",
    "@graphql-tools/utils": "^10.5.4",
    "@hookform/resolvers": "^3.9.1",
    "@kinde-oss/kinde-auth-nextjs": "^2.4.6",
    "@kinde/jwt-validator": "^0.3.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@mui/material-nextjs": "^5.15.11",
    "@mui/x-data-grid-pro": "^6.19.6",
    "@mui/x-license": "^7.6.0",
    "@prisma/client": "^5.22.0",
    "@toolpad/core": "^0.11.0",
    "@vercel/postgres": "^0.10.0",
    "final-form": "^4.20.10",
    "graphql": "^16.8.1",
    "graphql-request": "^7.1.2",
    "graphql-tools": "^9.0.1",
    "is-email": "^1.0.2",
    "next": "^14.2.11",
    "punycode": "^2.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-final-form": "^6.5.9",
    "react-hook-form": "^7.54.1",
    "react-icons": "^5.3.0",
    "superstruct": "^1.0.4",
    "ts-node": "^10.9.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@paralleldrive/cuid2": "^2.2.2",
    "@types/is-email": "^1.0.0",
    "@types/node": "^20.11.27",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "^14.2.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "pretty-quick": "^4.0.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.4.2"
  },
  "lint-staged": {
    "*.{js,ts,jsx}": [
      "pretty-quick --staged",
      "eslint --fix",
      "git add",
      "prettier --write"
    ],
    "*.js": "eslint --cache --fix"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
