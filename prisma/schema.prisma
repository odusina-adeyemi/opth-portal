generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Action_Item {
  id                   String               @id @default(cuid())
  createdAt            DateTime?            @default(now())
  dueDate              DateTime?            @db.Date
  updatedAt            DateTime?            @updatedAt
  assignedToId         String?
  associatedEntityId   String               @unique
  associatedEntityType AssociatedEntityType
  content              String?
  createdById          String?
  organizationId       String?
  status               ActionItemStatus?
  type                 ActionItemType?
  usersAssigned        User?                @relation("action_items_assignedToIdTousers", fields: [assignedToId], references: [id])
  patientClinic        Patient              @relation(fields: [associatedEntityId], references: [id], map: "action_items_patient_fkey")
  clinic               Clinic               @relation(fields: [associatedEntityId], references: [id], map: "action_items_clinic_fkey")
  provider             Provider             @relation(fields: [associatedEntityId], references: [id], map: "action_items_provider_fkey")
  createdByUser        User?                @relation("action_items_createdByIdTousers", fields: [createdById], references: [id])
  organization         Organization?        @relation(fields: [organizationId], references: [id])
  logs                 logs[]

  @@map("action_items")
}

model Clinic {
  id                                                               String           @id @default(cuid())
  address                                                          String?
  city                                                             String?
  email                                                            String?
  state                                                            String?
  name                                                             String?
  type                                                             String?
  phoneNumber                                                      String?
  zipCode                                                          String?
  createdAt                                                        DateTime?        @default(now())
  updatedAt                                                        DateTime?        @updatedAt
  referrerStatusTimeline                                           Json?            @db.Json
  faxNumber                                                        String?
  notes                                                            String?
  referralManager                                                  String?
  organizationId                                                   String?
  failedClinicsOrganizationId                                      String?
  action_items                                                     Action_Item?
  organizations_clinics_failedClinicsOrganizationIdToorganizations Organization?    @relation("clinics_failedClinicsOrganizationIdToorganizations", fields: [failedClinicsOrganizationId], references: [id])
  organization                                                     Organization?    @relation(fields: [organizationId], references: [id])
  files                                                            File[]
  patientReferrals                                                 Patient[]        @relation("PatientToReferringClinic")
  surgeonClinics                                                   Patient[]        @relation("PatientToSurgeonClinic")
  providerClinics                                                  ProviderClinic[]
  patients                                                         Patient[]        @relation("ClinicToPatient")
  patientContact                                                   PatientContact[] @relation("ClinicToPatientContact")
  postOperations                                                   PostOperation[]  @relation("ClinicToPostOperation")
  preOperations                                                    PreOperation[]   @relation("ClinicToPreOperation")
  providers                                                        Provider[]       @relation("ClinicToProvider")

  @@map("clinics")
}

model File {
  id         String    @id @default(cuid())
  clinicId   String?
  createdAt  DateTime? @default(now())
  name       String?
  providerId String?
  url        String?
  userId     String?
  updatedAt  DateTime? @updatedAt
  isArchived Boolean?  @default(false)
  clinic     Clinic?   @relation(fields: [clinicId], references: [id])
  provider   Provider? @relation(fields: [providerId], references: [id])
  user       User?     @relation(fields: [userId], references: [id])

  @@map("files")
}

model InsuranceCompanies {
  id                                                          String        @id @default(cuid())
  isCommercial                                                Boolean?      @default(false)
  name                                                        String?
  createdAt                                                   DateTime?     @default(now())
  updatedAt                                                   DateTime?     @updatedAt
  organizationId                                              String?
  organization                                                Organization? @relation(fields: [organizationId], references: [id])
  patients_patients_primaryInsuranceIdToinsurance_companies   Patient?      @relation("patients_primaryInsuranceIdToinsurance_companies")
  patients_patients_secondaryInsuranceIdToinsurance_companies Patient?      @relation("patients_secondaryInsuranceIdToinsurance_companies")
  patients_InsuranceCompaniesToPatient                        Patient[]     @relation("InsuranceCompaniesToPatient")

  @@map("insurance_companies")
}

model Organization {
  id                                                               String               @id @default(cuid())
  name                                                             String?
  createdAt                                                        DateTime?            @default(now())
  updatedAt                                                        DateTime?            @updatedAt
  dateLastClinicsFetch                                             DateTime?            @db.Date
  dateLastProvidersFetch                                           DateTime?            @db.Date
  dateLastReferralsFetch                                           DateTime?            @db.Date
  ehrVersion                                                       String?
  action_items                                                     Action_Item[]
  clinics_clinics_failedClinicsOrganizationIdToorganizations       Clinic[]             @relation("clinics_failedClinicsOrganizationIdToorganizations")
  clinics                                                          Clinic[]
  insuranceCompanies                                               InsuranceCompanies[]
  patients_patients_failedPatientsOrganizationIdToorganizations    Patient[]            @relation("patients_failedPatientsOrganizationIdToorganizations")
  patients                                                         Patient[]
  providerStatuses                                                 ProviderStatus[]
  providers_providers_failedProvidersOrganizationIdToorganizations Provider[]           @relation("providers_failedProvidersOrganizationIdToorganizations")
  providers                                                        Provider[]
  users                                                            User[]

  @@map("organizations")
}

model Patient {
  dob                                                                    String
  firstName                                                              String?
  lastName                                                               String?
  id                                                                     String               @id @default(cuid())
  createdAt                                                              DateTime?            @default(now())
  updatedAt                                                              DateTime?            @updatedAt
  referringProviderId                                                    String?
  surgeonId                                                              String?
  referringClinicId                                                      String?
  surgeonClinicId                                                        String?
  organizationId                                                         String?
  consentFormSigned                                                      Boolean?             @default(false)
  generalNotes                                                           String?
  email                                                                  String?
  phoneNumber                                                            String?
  primaryInsuranceId                                                     String?              @unique
  secondaryInsuranceId                                                   String?              @unique
  failedPatientsOrganizationId                                           String?
  action_items                                                           Action_Item?
  patientContacts                                                        PatientContact?
  organizations_patients_failedPatientsOrganizationIdToorganizations     Organization?        @relation("patients_failedPatientsOrganizationIdToorganizations", fields: [failedPatientsOrganizationId], references: [id])
  organization                                                           Organization?        @relation(fields: [organizationId], references: [id])
  insurance_companies_patients_primaryInsuranceIdToinsurance_companies   InsuranceCompanies?  @relation("patients_primaryInsuranceIdToinsurance_companies", fields: [primaryInsuranceId], references: [id])
  referringClinic                                                        Clinic?              @relation("PatientToReferringClinic", fields: [referringClinicId], references: [id])
  referringProvider                                                      Provider?            @relation("PatientToReferringProvider", fields: [referringProviderId], references: [id])
  insurance_companies_patients_secondaryInsuranceIdToinsurance_companies InsuranceCompanies?  @relation("patients_secondaryInsuranceIdToinsurance_companies", fields: [secondaryInsuranceId], references: [id])
  surgeonClinic                                                          Clinic?              @relation("PatientToSurgeonClinic", fields: [surgeonClinicId], references: [id])
  surgeon                                                                Provider?            @relation("PatientToSurgeon", fields: [surgeonId], references: [id])
  postOperations                                                         PostOperation?
  preOperations                                                          PreOperation?
  clinics                                                                Clinic[]             @relation("ClinicToPatient")
  insurance_companies_InsuranceCompaniesToPatient                        InsuranceCompanies[] @relation("InsuranceCompaniesToPatient")
  providers                                                              Provider[]           @relation("PatientToProvider")

  @@map("patients")
}

model PatientContact {
  id                              String     @id @default(cuid())
  contactNotes                    String?
  dateAttemptedFirstContact       DateTime?  @db.Timestamp(6)
  dateComanagerAware              DateTime?  @db.Timestamp(6)
  dateInitialAppointmentScheduled DateTime?  @db.Date
  dateReferralReceived            DateTime?  @db.Timestamp(6)
  patientId                       String?    @unique
  createdAt                       DateTime?  @default(now())
  updatedAt                       DateTime?  @updatedAt
  patient                         Patient?   @relation(fields: [patientId], references: [id])
  clinics                         Clinic[]   @relation("ClinicToPatientContact")
  providers                       Provider[] @relation("PatientContactToProvider")

  @@map("patientContacts")
}

model PreOperation {
  id                          String     @id @default(cuid())
  patientId                   String?    @unique
  createdAt                   DateTime?  @default(now())
  updatedAt                   DateTime?  @updatedAt
  consultationReportSent      Boolean?
  delayInSurgery              Boolean?
  delayLetterSent             Boolean?
  delayReason                 String?
  eyesToBeDone                String?
  firstEyeSurgeryDate         DateTime?  @db.Date
  firstEyeSurgeryType         String?
  initialAppointmentCompleted Boolean?
  isComanage                  Boolean?
  reasonNoSurgeryScheduled    String?
  reasonNotComanage           String?
  secondEyeSurgeryDate        DateTime?  @db.Date
  secondEyeSurgeryType        String?
  surgeryScheduled            Boolean?
  isMedicare                  Boolean?
  originalReferralType        String?
  isReverseReferral           Boolean?
  firstEye                    String?
  secondEye                   String?
  patient                     Patient?   @relation(fields: [patientId], references: [id])
  clinics                     Clinic[]   @relation("ClinicToPreOperation")
  providers                   Provider[] @relation("PreOperationToProvider")

  @@map("preOperations")
}

model Provider {
  id                                                                   String           @id @default(cuid())
  image                                                                String?
  status                                                               String?
  type                                                                 String?
  firstName                                                            String?
  lastName                                                             String?
  specialties                                                          String[]         @default([])
  createdAt                                                            DateTime?        @default(now())
  updatedAt                                                            DateTime?        @updatedAt
  dateVisitedByLiaison                                                 String?
  dateVisitedByProvider                                                String?
  email                                                                String?
  notes                                                                String?
  phoneNumber                                                          String?
  organizationId                                                       String?
  consentFormOnFile                                                    Boolean?         @default(false)
  hasDemographics                                                      Boolean?         @default(false)
  hasW9                                                                Boolean?         @default(false)
  failedProvidersOrganizationId                                        String?
  action_items                                                         Action_Item?
  files                                                                File[]
  patientsReferred                                                     Patient[]        @relation("PatientToReferringProvider")
  surgeons                                                             Patient[]        @relation("PatientToSurgeon")
  providerClinics                                                      ProviderClinic[]
  organizations_providers_failedProvidersOrganizationIdToorganizations Organization?    @relation("providers_failedProvidersOrganizationIdToorganizations", fields: [failedProvidersOrganizationId], references: [id])
  organization                                                         Organization?    @relation(fields: [organizationId], references: [id])
  clinics                                                              Clinic[]         @relation("ClinicToProvider")
  patientContact                                                       PatientContact[] @relation("PatientContactToProvider")
  patients                                                             Patient[]        @relation("PatientToProvider")
  postOperations                                                       PostOperation[]  @relation("PostOperationToProvider")
  preOperations                                                        PreOperation[]   @relation("PreOperationToProvider")
  user                                                                 User?

  @@map("providers")
}

model ProviderClinic {
  consentFormOnFile Boolean
  hasDemographics   Boolean
  providerId        String
  clinicId          String
  hasW9             Boolean
  clinic            Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  provider          Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([providerId, clinicId])
  @@map("provider_clinics")
}

model ProviderStatus {
  id             String        @id @default(cuid())
  description    String?
  organizationId String?
  status         String?
  createdAt      DateTime?     @default(now())
  updatedAt      DateTime?     @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("provider_statuses")
}

model PostOperation {
  id                           String     @id @default(cuid())
  checkNumber                  Int?
  checkDelivered               Boolean?
  contactedReferrer            Boolean?
  reasonNotReferredBack        String?
  referredBackToOriginalClinic Boolean?
  referralCompleted            Boolean?
  referralCanceled             Boolean?
  referralCanceledReason       String?
  postOpVisitDate              DateTime?  @db.Date
  typeOfInsurance              String?
  patientId                    String?    @unique
  createdAt                    DateTime?  @default(now())
  updatedAt                    DateTime?  @updatedAt
  amountToBePaidFromInsurance  Decimal?
  amountToPayProvider          Decimal?
  paidOptomDate                DateTime?  @db.Date
  checkDeliveryPaperwork       Boolean?
  transferOfCareDateLeftEye    DateTime?  @db.Date
  transferOfCareDateRightEye   DateTime?  @db.Date
  transferOfCareLeftEye        Boolean?
  transferOfCareRightEye       Boolean?
  postOpNotesReceivedLeftEye   Boolean?
  postOpNotesReceivedRightEye  Boolean?
  referralCompletedAt          DateTime?  @db.Date
  patient                      Patient?   @relation(fields: [patientId], references: [id])
  clinics                      Clinic[]   @relation("ClinicToPostOperation")
  providers                    Provider[] @relation("PostOperationToProvider")

  @@map("postOperations")
}

model User {
  id                                            String        @id @default(cuid())
  email                                         String?       @unique
  role                                          String?       @default("specialist")
  firstName                                     String?
  lastName                                      String?
  createdAt                                     DateTime?     @default(now())
  updatedAt                                     DateTime?     @updatedAt
  organizationId                                String?
  action_items_action_items_assignedToIdTousers Action_Item[] @relation("action_items_assignedToIdTousers")
  action_items_action_items_createdByIdTousers  Action_Item[] @relation("action_items_createdByIdTousers")
  files                                         File[]
  logs                                          logs[]
  organization                                  Organization? @relation(fields: [organizationId], references: [id])
  providerId                                    String?       @unique // Field to reference Provider
  provider                                      Provider?     @relation(fields: [providerId], references: [id]) // Defines the relation to Provider

  @@map("users")
}

model logs {
  id           String       @id
  actionItemId String?
  createdAt    DateTime     @default(now())
  message      String?
  userId       String?
  action_items Action_Item? @relation(fields: [actionItemId], references: [id])
  users        User?        @relation(fields: [userId], references: [id])
}

enum ActionItemStatus {
  Complete
  Incomplete
  Pending
  Read
  Unread
}

enum ActionItemType {
  Notice
  Task
}

enum AssociatedEntityType {
  Clinic
  Patient
  Provider
  User
}
